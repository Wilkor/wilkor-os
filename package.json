    "@uiw/react-codemirror": "^4.25.9",
    "adm-zip": "^0.5.17",
    "axios": "1.7.9",
    "chart.js": "^4.5.1",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
